NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maritime_logistics
DB_USER=app_user
DB_PASSWORD=replace_me
JWT_SECRET=generate_a_random_value_of_at_least_32_characters
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ENABLE_LEGACY_PROVIDER_ROUTES=false
AIS_API_KEY=
CUSTOMS_API_KEY=
WEATHER_API_KEY=
